package practice;
class Animal{
	void sound() {
		System.out.println("Animal makes sound");
	}
}
class Dog extends Animal{
	void bark() {
		System.out.println("Dogs barks");
	}
}
public class inherit {
	public static void main(String[] args) {
	Dog d=new Dog();
	d.sound();
	d.bark();
	}
}


